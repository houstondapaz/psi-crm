# Copy this file to `.env` and replace placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 17.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Auth.js session/JWT signing (required). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL used by Auth.js in production.
AUTH_URL="https://crm.example.com"

# Required in production to create the first consultório from `/register`.
REGISTRATION_TOKEN="change-me"
